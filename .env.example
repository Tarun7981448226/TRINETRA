# Free keys: https://aistudio.google.com  and  https://console.groq.com
GEMINI_API_KEY=
GROQ_API_KEY=
# Pools of free models per tier, best first. When one hits its free limit, the next takes over.
TRINETRA_MODELS_SMART=gemini/gemini-3.5-flash,groq/openai/gpt-oss-120b,gemini/gemini-2.5-flash,groq/qwen/qwen3.8-27b
TRINETRA_MODELS_FAST=groq/openai/gpt-oss-20b,gemini/gemini-3.5-flash-lite,gemini/gemini-flash-lite-latest,groq/qwen/qwen3.8-27b
TRINETRA_TIMEZONE=Asia/Kolkata
TRINETRA_USER_NAME=Tarun
TRINETRA_STRICTNESS=3
# Male voice: en-US-ChristopherNeural (deep mentor, default; ~1s to speak), en-US-GuyNeural (fastest), en-GB-RyanNeural.
# Avoid the Andrew voices: they take 4-15s before the first sound.
TRINETRA_VOICE=en-US-ChristopherNeural
# Passcode to open TRINETRA from any device (change it anytime; everyone gets logged out)
TRINETRA_PASSCODE=
TRINETRA_SECRET=
# Web-push contact. Apple rejects fake addresses like mailto:x@localhost — use your TRINETRA URL.
TRINETRA_CONTACT_EMAIL=https://your-trinetra-address

# WhatsApp autopilot: the bridge on Render (bridge/, render.yaml). Same key on both sides.
TRINETRA_BRIDGE_URL=
TRINETRA_BRIDGE_KEY=
